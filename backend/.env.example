# ==========================================
# Backend Environment Variables
# ==========================================

# Server Port (Render sets this automatically to 10000 or custom)
PORT=3001

# Production Frontend URL(s) allowed via CORS (comma-separated if multiple)
# Local dev: http://localhost:5173
# Render production: https://youtube-watch-party-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Environment mode
NODE_ENV=production
