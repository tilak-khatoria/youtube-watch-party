{
  "name": "backend",
  "version": "1.0.0",
  "description": "YouTube Watch Party Backend",
  "main": "dist/src/server.js",
  "scripts": {
    "prebuild": "npm install --include=dev",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "nodemon --watch src -e ts --exec \"npm run build && node dist/src/server.js\""
  },
  "keywords": [
    "youtube",
    "watch-party",
    "socket.io",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
